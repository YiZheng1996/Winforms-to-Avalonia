<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModbusAvalonia.PlcEditWindow"
        Title="编辑PLC"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="10" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Content="确定" Width="80" Click="btnOK_Click" />
            <Button x:Name="btnCancel" Content="取消" Width="80" Click="btnCancel_Click" />
        </StackPanel>

        <StackPanel Margin="12" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="类型:" VerticalAlignment="Center" />
                <ComboBox x:Name="cmbType" Width="180" SelectedIndex="0">
                    <ComboBoxItem Content="Smart200" />
                    <ComboBoxItem Content="信捷 Xinje" />
                    <ComboBoxItem Content="S7-1200" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="IP:" VerticalAlignment="Center" />
                <TextBox x:Name="txtIP" Width="180" Watermark="192.168.1.111" />
                <CheckBox x:Name="chkEnabled" Content="启用(Enabled=1)" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="CSV 点表文件列表:" />
            <ListBox x:Name="lstCsvFiles" Height="160" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="txtCsvFile" Width="180" Watermark="文件名" />
                <Button x:Name="btnBrowse" Content="浏览..." Width="70" Click="btnBrowse_Click" />
                <Button x:Name="btnAddFile" Content="添加" Width="60" Click="btnAddFile_Click" />
                <Button x:Name="btnRemoveFile" Content="删除选中" Width="80" Click="btnRemoveFile_Click" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
