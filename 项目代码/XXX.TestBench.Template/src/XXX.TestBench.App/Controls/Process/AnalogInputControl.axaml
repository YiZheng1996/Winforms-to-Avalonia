<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:process="using:XXX.TestBench.App.Controls.Process"
             xmlns:vm="using:XXX.TestBench.App.ViewModels.Process"
             x:Class="XXX.TestBench.App.Controls.Process.AnalogInputControl"
             x:DataType="vm:AnalogInputPointViewModel">
  <Border Background="White" BorderBrush="#D6DEEA" BorderThickness="1" CornerRadius="8" Padding="14">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="#151A24" />
        <process:PointStatusBadge Grid.Column="1" Text="{Binding StatusText}" State="{Binding State}" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding ValueText}" FontSize="32" FontWeight="Bold" Foreground="#151A24"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Unit}" FontSize="14" Foreground="#667085" />
          <TextBlock Text="{Binding LimitText}" FontSize="12" Foreground="#667085" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <process:MiniTrendControl Samples="{Binding TrendSamples}" Height="32" />
        <TextBlock Grid.Column="1" Text="{Binding PointText}" FontSize="11" Foreground="#98A2B3"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="125" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
