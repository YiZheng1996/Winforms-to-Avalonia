<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels.Process"
             x:Class="XXX.TestBench.App.Controls.Process.DigitalInputControl"
             x:DataType="vm:DigitalInputPointViewModel"
             MinHeight="62">
  <UserControl.Styles>
    <Style Selector="Border.point-row">
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="BorderBrush" Value="#DDE7F2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Ellipse.point-light">
      <Setter Property="Fill" Value="#98A2B3" />
    </Style>
    <Style Selector="Ellipse.point-light.good">
      <Setter Property="Fill" Value="#18A654" />
    </Style>
    <Style Selector="TextBlock.point-state">
      <Setter Property="Foreground" Value="#667085" />
    </Style>
    <Style Selector="TextBlock.point-state.good">
      <Setter Property="Foreground" Value="#168B49" />
    </Style>
  </UserControl.Styles>

  <Border Classes="point-row" ToolTip.Tip="{Binding DisplayPointText}">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                 Foreground="#182B4A" VerticalAlignment="Center" />
      <Ellipse Grid.Column="1" Width="20" Height="20" Classes="point-light"
               Classes.good="{Binding IsDisplayedActiveGood}"
               VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding DisplayActiveText}" Classes="point-state"
                 Classes.good="{Binding IsDisplayedActiveGood}" FontSize="15" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
