<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels.Process"
             x:Class="XXX.TestBench.App.Controls.Process.DigitalOutputControl"
             x:DataType="vm:DigitalOutputPointViewModel"
             MinHeight="62">
  <UserControl.Styles>
    <Style Selector="Border.point-row">
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="BorderBrush" Value="#DDE7F2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Ellipse.point-light">
      <Setter Property="Fill" Value="#98A2B3" />
    </Style>
    <Style Selector="Ellipse.point-light.good">
      <Setter Property="Fill" Value="#18A654" />
    </Style>
    <Style Selector="TextBlock.point-state">
      <Setter Property="Foreground" Value="#667085" />
    </Style>
    <Style Selector="TextBlock.point-state.good">
      <Setter Property="Foreground" Value="#168B49" />
    </Style>
    <Style Selector="Button.output-button">
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0868F7" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.output-button.primary">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.output-button.demo:disabled">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0868F7" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.output-button.primary.demo:disabled">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
    </Style>
  </UserControl.Styles>

  <Border Classes="point-row" ToolTip.Tip="{Binding DisplayPointText}">
    <Grid ColumnDefinitions="*,20,Auto,Auto,Auto" ColumnSpacing="7">
      <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                 Foreground="#182B4A" VerticalAlignment="Center" />
      <Ellipse x:Name="PointLight" Grid.Column="1" Width="20" Height="20" Classes="point-light"
               Classes.good="{Binding IsDisplayedOpen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock x:Name="PointState" Grid.Column="2" Text="{Binding DisplayFeedbackText}" Classes="point-state"
                 Classes.good="{Binding IsDisplayedOpen}" FontSize="14" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <Button Grid.Column="3" Classes="output-button primary" Content="开启"
              Classes.demo="{Binding IsDemoData}"
              Command="{Binding DisplayOpenCommand}" AutomationProperties.Name="开启阀门" />
      <Button Grid.Column="4" Classes="output-button" Content="关闭"
              Classes.demo="{Binding IsDemoData}"
              Command="{Binding DisplayCloseCommand}" AutomationProperties.Name="关闭阀门" />
    </Grid>
  </Border>
</UserControl>
