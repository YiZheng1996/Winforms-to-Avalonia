<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:process="using:XXX.TestBench.App.Controls.Process"
             xmlns:vm="using:XXX.TestBench.App.ViewModels.Process"
             x:Class="XXX.TestBench.App.Controls.Process.DigitalOutputControl"
             x:DataType="vm:DigitalOutputPointViewModel">
  <Border Background="White" BorderBrush="#D6DEEA" BorderThickness="1" CornerRadius="8" Padding="14">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="#151A24" />
        <process:PointStatusBadge Grid.Column="1" Text="{Binding StatusText}" State="{Binding State}" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="实际反馈" FontSize="12" Foreground="#667085" />
          <TextBlock Text="{Binding FeedbackText}" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding WriteStateText}" FontSize="12" Foreground="#D97706"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="100" />
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="打开" Command="{Binding OpenCommand}" MinWidth="72" MinHeight="38"
                AutomationProperties.Name="打开阀门" />
        <Button Content="关闭" Command="{Binding CloseCommand}" MinWidth="72" MinHeight="38"
                AutomationProperties.Name="关闭阀门" />
      </StackPanel>
      <TextBlock Grid.Row="3" Text="{Binding PointText}" FontSize="12" Foreground="#98A2B3"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</UserControl>
