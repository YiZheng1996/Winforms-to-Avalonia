<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:process="using:XXX.TestBench.App.Controls.Process"
             xmlns:vm="using:XXX.TestBench.App.ViewModels.Process"
             x:Class="XXX.TestBench.App.Controls.Process.PneumaticDiagramControl"
             x:DataType="vm:ProcessDiagramViewModel"
             MinHeight="430">
  <UserControl.Styles>
    <Style Selector="Border.diagram-panel">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D6E1EE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,10,14,12" />
    </Style>
    <Style Selector="Border.diagram-surface">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E1E9F3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.readout-card">
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="BorderBrush" Value="#C6D6E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="TextBlock.readout-type">
      <Setter Property="Foreground" Value="#142B4E" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.readout-name">
      <Setter Property="Foreground" Value="#142B4E" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.readout-value">
      <Setter Property="Foreground" Value="#0868F7" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.diagram-do-card">
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="BorderBrush" Value="#C6D6E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.diagram-do-card.good">
      <Setter Property="Background" Value="#F0FFF5" />
      <Setter Property="BorderBrush" Value="#A8E0BC" />
    </Style>
    <Style Selector="Ellipse.diagram-light">
      <Setter Property="Fill" Value="#6D7C92" />
    </Style>
    <Style Selector="Ellipse.diagram-light.good">
      <Setter Property="Fill" Value="#18A654" />
    </Style>
    <Style Selector="TextBlock.diagram-state">
      <Setter Property="Foreground" Value="#53627A" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.diagram-state.good">
      <Setter Property="Foreground" Value="#168B49" />
    </Style>
    <Style Selector="Button.diagram-adjust-button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="25" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#142B4E" />
      <Setter Property="BorderBrush" Value="#D2DCE9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.diagram-apply-button">
      <Setter Property="Height" Value="25" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.diagram-apply-button:disabled">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Border Classes="diagram-panel">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock Text="气路工艺图" FontSize="22" FontWeight="Bold" Foreground="#142B4E" />
          <TextBlock Text="示例气路" FontSize="16" Foreground="#63718A" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="26" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="40" Height="5" CornerRadius="3" Background="#0868F7" VerticalAlignment="Center" />
            <TextBlock Text="带压管路" Foreground="#53627A" FontSize="14" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="40" Height="5" CornerRadius="3" Background="#98A2B3" VerticalAlignment="Center" />
            <TextBlock Text="未带压" Foreground="#53627A" FontSize="14" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="18" Height="18" Fill="#18A654" />
            <TextBlock Text="阀门开启" Foreground="#53627A" FontSize="14" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="18" Height="18" Fill="#6D7C92" />
            <TextBlock Text="阀门关闭" Foreground="#53627A" FontSize="14" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Classes="diagram-surface" ClipToBounds="True">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Viewbox Width="1360" Height="440" Stretch="Uniform">
            <Canvas Width="1360" Height="440" Background="White">
              <!-- 主气路：压力状态只来自对应的有效缓存样本。 -->
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="40,190" EndPoint="265,190" PressureState="{Binding DisplaySupplyPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="265,190" EndPoint="465,190" PressureState="{Binding DisplaySupplyPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="465,190" EndPoint="850,190" PressureState="{Binding DisplayMainPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="850,190" EndPoint="970,190" PressureState="{Binding DisplayDutPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="970,190" EndPoint="1190,190" PressureState="{Binding DisplayDutPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="970,190" EndPoint="970,310" PressureState="{Binding DisplayDutPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="970,310" EndPoint="970,382" PressureState="{Binding DisplayExhaustPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="970,382" EndPoint="1080,382" PressureState="{Binding DisplayExhaustPipeState}" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="1180,382" EndPoint="1270,382" PressureState="{Binding DisplayExhaustPipeState}" />

              <!-- 示意控制信号虚线，不代表未经确认的真实气管。 -->
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="178,305" EndPoint="300,305" IsDashed="True" IsControlSignal="True" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="178,370" EndPoint="300,370" IsDashed="True" IsControlSignal="True" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="300,305" EndPoint="300,370" IsDashed="True" IsControlSignal="True" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="300,370" EndPoint="1290,370" IsDashed="True" IsControlSignal="True" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="1290,370" EndPoint="1290,220" IsDashed="True" IsControlSignal="True" />
              <process:PneumaticPipeControl Width="1360" Height="440"
                StartPoint="850,92" EndPoint="850,160" IsDashed="True" IsControlSignal="True" />

              <!-- 气源入口与元件符号。 -->
              <Polygon Points="12,190 40,177 40,203" Fill="#6D7C92" />
              <Polygon Points="235,190 265,158 295,190 265,222" Fill="White"
                       Stroke="#142B4E" StrokeThickness="2" />
              <Line StartPoint="265,164" EndPoint="265,216" Stroke="#0868F7" StrokeThickness="2"
                    StrokeDashArray="4,4" />

              <Border Canvas.Left="435" Canvas.Top="160" Width="60" Height="60"
                      Background="White" BorderBrush="#142B4E" BorderThickness="2">
                <Grid>
                  <Line StartPoint="10,48" EndPoint="48,12" Stroke="#142B4E" StrokeThickness="2" />
                  <Polygon Points="48,12 39,15 45,22" Fill="#142B4E" />
                  <Line StartPoint="30,0" EndPoint="30,11" Stroke="#142B4E" StrokeThickness="2" />
                  <Line StartPoint="25,0" EndPoint="35,0" Stroke="#142B4E" StrokeThickness="2" />
                  <Line StartPoint="35,48" EndPoint="51,48" Stroke="#142B4E" StrokeThickness="2"
                        StrokeDashArray="4,4" />
                </Grid>
              </Border>

              <process:PneumaticValveSymbol Canvas.Left="790" Canvas.Top="155" Width="120" Height="70"
                Feedback="{Binding InletFeedback.DisplayIsActive}" State="{Binding InletFeedback.DisplayedState}"
                Label="进气阀" />
              <process:PneumaticValveSymbol Canvas.Left="910" Canvas.Top="275" Width="120" Height="70"
                Feedback="{Binding ExhaustFeedback.DisplayIsActive}" State="{Binding ExhaustFeedback.DisplayedState}"
                Label="排气阀" />

              <Border Canvas.Left="1110" Canvas.Top="165" Width="160" Height="50"
                      Background="#F9FBFE" BorderBrush="#142B4E" BorderThickness="2" CornerRadius="25">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="14" Height="46" BorderBrush="#142B4E" BorderThickness="0,0,2,0"
                          CornerRadius="10,0,0,10" />
                  <Border Grid.Column="2" Width="14" Height="46" BorderBrush="#142B4E" BorderThickness="2,0,0,0"
                          CornerRadius="0,10,10,0" />
                </Grid>
              </Border>

              <Border Canvas.Left="1080" Canvas.Top="365" Width="100" Height="36"
                      Background="#F9FBFE" BorderBrush="#142B4E" BorderThickness="2" CornerRadius="7">
                <Grid ColumnDefinitions="*,*,*,*">
                  <Border Margin="8,5" BorderBrush="#142B4E" BorderThickness="2,0,0,0" />
                  <Border Grid.Column="1" Margin="8,5" BorderBrush="#142B4E" BorderThickness="2,0,0,0" />
                  <Border Grid.Column="2" Margin="8,5" BorderBrush="#142B4E" BorderThickness="2,0,0,0" />
                  <Border Grid.Column="3" Margin="8,5" BorderBrush="#142B4E" BorderThickness="2,0,0,0" />
                </Grid>
              </Border>

              <!-- 压力测点与浮动读数卡。 -->
              <Line StartPoint="140,190" EndPoint="140,78" Stroke="#142B4E" StrokeThickness="2" />
              <Line StartPoint="690,190" EndPoint="690,78" Stroke="#142B4E" StrokeThickness="2" />
              <Line StartPoint="1190,190" EndPoint="1190,78" Stroke="#142B4E" StrokeThickness="2" />
              <Border Canvas.Left="123" Canvas.Top="173" Width="34" Height="34" CornerRadius="17"
                      Background="White" BorderBrush="#142B4E" BorderThickness="2">
                <TextBlock Text="P" FontSize="20" Foreground="#142B4E" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border Canvas.Left="673" Canvas.Top="173" Width="34" Height="34" CornerRadius="17"
                      Background="White" BorderBrush="#142B4E" BorderThickness="2">
                <TextBlock Text="P" FontSize="20" Foreground="#142B4E" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border Canvas.Left="1173" Canvas.Top="173" Width="34" Height="34" CornerRadius="17"
                      Background="White" BorderBrush="#142B4E" BorderThickness="2">
                <TextBlock Text="P" FontSize="20" Foreground="#142B4E" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>

              <Border Canvas.Left="86" Canvas.Top="18" Width="145" Height="58" Classes="readout-card">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AI" Classes="readout-type" />
                    <TextBlock Text="气源压力" Classes="readout-name" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SupplyPressure.DisplayValueText}" Classes="readout-value" />
                    <TextBlock Text="MPa" FontSize="13" Foreground="#142B4E" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Canvas.Left="360" Canvas.Top="18" Width="215" Height="58" Classes="readout-card">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AO" Classes="readout-type" />
                    <TextBlock Text="调压设定" Classes="readout-name" />
                  </StackPanel>
                  <Grid Grid.Row="1" ColumnDefinitions="26,76,26,Auto,Auto" ColumnSpacing="4">
                    <Button Grid.Column="0" Classes="diagram-adjust-button" Content="−"
                            Command="{Binding PressureSetpoint.DecreaseTargetCommand}" />
                    <TextBlock Grid.Column="1" Text="{Binding PressureSetpoint.TargetText}" FontSize="15"
                               Foreground="#142B4E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="diagram-adjust-button" Content="＋"
                            Command="{Binding PressureSetpoint.IncreaseTargetCommand}" />
                    <TextBlock Grid.Column="3" Text="MPa" FontSize="13" Foreground="#142B4E"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="4" Classes="diagram-apply-button" Content="设置"
                            Command="{Binding PressureSetpoint.DisplayApplyCommand}" />
                  </Grid>
                </Grid>
              </Border>
              <Border Canvas.Left="617" Canvas.Top="18" Width="145" Height="58" Classes="readout-card">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AI" Classes="readout-type" />
                    <TextBlock Text="主管压力" Classes="readout-name" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding MainPressure.DisplayValueText}" Classes="readout-value" />
                    <TextBlock Text="MPa" FontSize="13" Foreground="#142B4E" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Canvas.Left="820" Canvas.Top="18" Width="132" Height="58" Classes="diagram-do-card"
                      Classes.good="{Binding InletValve.IsDisplayedOpen}">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="DO" Classes="readout-type" />
                    <TextBlock Text="进气阀" Classes="readout-name" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9">
                    <Ellipse Width="18" Height="18" Classes="diagram-light"
                             Classes.good="{Binding InletValve.IsDisplayedOpen}" />
                    <TextBlock Text="{Binding InletValve.DisplayFeedbackText}" Classes="diagram-state"
                               Classes.good="{Binding InletValve.IsDisplayedOpen}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Canvas.Left="1088" Canvas.Top="18" Width="145" Height="58" Classes="readout-card">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AI" Classes="readout-type" />
                    <TextBlock Text="被试件压力" Classes="readout-name" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DutPressure.DisplayValueText}" Classes="readout-value" />
                    <TextBlock Text="MPa" FontSize="13" Foreground="#142B4E" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- 安全门、夹紧到位和排气控制反馈。 -->
              <Border Canvas.Left="30" Canvas.Top="274" Width="150" Height="58" Classes="diagram-do-card"
                      Classes.good="{Binding SafetyDoor.IsDisplayedActiveGood}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                  <TextBlock Text="DI" Classes="readout-type" />
                  <TextBlock Grid.Column="1" Text="安全门" Classes="readout-name" />
                  <Ellipse Grid.Column="2" Width="18" Height="18" Classes="diagram-light"
                           Classes.good="{Binding SafetyDoor.IsDisplayedActiveGood}" />
                  <TextBlock Grid.Column="3" Text="{Binding SafetyDoor.DisplayActiveText}" Classes="diagram-state"
                             Classes.good="{Binding SafetyDoor.IsDisplayedActiveGood}" />
                </Grid>
              </Border>
              <Border Canvas.Left="30" Canvas.Top="340" Width="150" Height="58" Classes="diagram-do-card"
                      Classes.good="{Binding ClampReady.IsDisplayedActiveGood}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                  <TextBlock Text="DI" Classes="readout-type" />
                  <TextBlock Grid.Column="1" Text="夹紧到位" Classes="readout-name" />
                  <Ellipse Grid.Column="2" Width="18" Height="18" Classes="diagram-light"
                           Classes.good="{Binding ClampReady.IsDisplayedActiveGood}" />
                  <TextBlock Grid.Column="3" Text="{Binding ClampReady.DisplayActiveText}" Classes="diagram-state"
                             Classes.good="{Binding ClampReady.IsDisplayedActiveGood}" />
                </Grid>
              </Border>
              <Border Canvas.Left="1025" Canvas.Top="260" Width="132" Height="58" Classes="diagram-do-card"
                      Classes.good="{Binding ExhaustValve.IsDisplayedOpen}">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="DO" Classes="readout-type" />
                    <TextBlock Text="排气阀" Classes="readout-name" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9">
                    <Ellipse Width="18" Height="18" Classes="diagram-light"
                             Classes.good="{Binding ExhaustValve.IsDisplayedOpen}" />
                    <TextBlock Text="{Binding ExhaustValve.DisplayFeedbackText}" Classes="diagram-state"
                               Classes.good="{Binding ExhaustValve.IsDisplayedOpen}" />
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Canvas.Left="14" Canvas.Top="214" Text="气源入口" FontSize="16"
                         FontWeight="SemiBold" Foreground="#142B4E" />
              <TextBlock Canvas.Left="238" Canvas.Top="214" Text="过滤器" FontSize="16"
                         FontWeight="SemiBold" Foreground="#142B4E" />
              <TextBlock Canvas.Left="424" Canvas.Top="214" Text="比例调压阀" FontSize="16"
                         FontWeight="SemiBold" Foreground="#142B4E" />
              <TextBlock Canvas.Left="820" Canvas.Top="214" Text="进气阀" FontSize="16"
                         FontWeight="SemiBold" Foreground="#142B4E" />
              <TextBlock Canvas.Left="1148" Canvas.Top="214" Text="被试件" FontSize="16"
                         FontWeight="SemiBold" Foreground="#142B4E" />
              <TextBlock Canvas.Left="934" Canvas.Top="342" Text="排气阀" FontSize="16"
                         FontWeight="SemiBold" Foreground="#142B4E" />
              <TextBlock Canvas.Left="1093" Canvas.Top="405" Text="消声器" FontSize="15"
                         Foreground="#142B4E" />
              <TextBlock Canvas.Left="1220" Canvas.Top="370" Text="大气排放" FontSize="15"
                         Foreground="#142B4E" />
              <TextBlock Canvas.Left="655" Canvas.Top="346" Text="信号至被试件" FontSize="13"
                         Foreground="#53627A" />
            </Canvas>
          </Viewbox>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</UserControl>
