<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels"
             xmlns:views="using:XXX.TestBench.App.Views"
             xmlns:icons="using:XXX.TestBench.App.Icons"
             x:Class="XXX.TestBench.App.Views.ParameterManagementView"
             x:DataType="vm:ParameterManagementViewModel"
             UseLayoutRounding="True">

  <Grid Background="{DynamicResource WorkspaceBrush}"
        RowDefinitions="Auto,*"
        RowSpacing="12"
        Margin="16,14,16,8">
    <!-- 页面标题：与主外壳保持同一套蓝白、轻边框视觉语言。 -->
    <Border Grid.Row="0" Classes="parameter-surface" Padding="18,14">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="4" Height="48" Background="{DynamicResource BrandBlueBrush}"
                CornerRadius="2" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="参数管理" FontSize="24" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="维护产品主数据、试验项点及自动执行参数"
                     Classes="parameter-hint" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="parameter-count" Background="#F0F7FF" BorderBrush="#CFE0FF">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource BrandBlueBrush}"
                       VerticalAlignment="Center" />
              <TextBlock Text="固定参数字段" Foreground="#0758D7" FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Classes="parameter-secondary" Command="{Binding LoadCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:AppIcon Kind="Refresh" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="刷新数据" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="parameter-tabs"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                TabStripPlacement="Top">
      <!-- 产品类型 -->
      <TabItem Classes="parameter-tab" IsVisible="{Binding CanManageProducts}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:AppIcon Kind="Category" Width="16" Height="16" Stroke="{DynamicResource BrandBlueBrush}" />
            <TextBlock Text="产品类型" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
          <Border Classes="parameter-surface" Padding="16,14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="parameter-icon">
                <icons:AppIcon Kind="Category" Width="20" Height="20" Stroke="{DynamicResource BrandBlueBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="产品类型" Classes="parameter-section-title" />
                <TextBlock Text="定义产品分类，作为产品型号与试验项点的组织入口"
                           Classes="parameter-hint" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Center">
                <Border Classes="parameter-count">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Types.Count}" Foreground="{DynamicResource BrandBlueBrush}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="个类型" Classes="parameter-label" />
                  </StackPanel>
                </Border>
                <Button Classes="parameter-ghost" Content="启用 / 停用"
                        Click="OnToggleTypeClick" IsEnabled="{Binding CanManageProducts}" />
                <Button Classes="parameter-secondary" Content="编辑"
                        Click="OnEditTypeClick" IsEnabled="{Binding CanManageProducts}" />
                <Button Classes="parameter-danger" Content="删除"
                        Click="OnDeleteTypeClick" IsEnabled="{Binding CanManageProducts}" />
                <Button Classes="parameter-primary" Click="OnAddTypeClick" IsEnabled="{Binding CanManageProducts}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <icons:AppIcon Kind="Add" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" />
                    <TextBlock Text="新增产品类型" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="parameter-surface" Padding="1">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#F8FAFD" Padding="16,11"
                      BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="类型清单" FontWeight="SemiBold" Foreground="#344054" />
                  <TextBlock Grid.Column="1" Text="选择一行后可进行状态、编辑或删除操作"
                             Classes="parameter-hint" HorizontalAlignment="Right" />
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <DataGrid Classes="parameter-grid"
                          ItemsSource="{Binding Types}"
                          SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="类型编号" Binding="{Binding Id}" Width="1.1*" />
                    <DataGridTextColumn Header="类型名称" Binding="{Binding Name}" Width="1.4*" />
                    <DataGridTemplateColumn Header="状态" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid HorizontalAlignment="Left">
                            <Border Background="#ECFDF3" CornerRadius="12" Padding="9,4"
                                    IsVisible="{Binding IsEnabled}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="#18A654" />
                                <TextBlock Text="启用" Foreground="#087443" FontSize="12" />
                              </StackPanel>
                            </Border>
                            <Border Background="#F2F4F7" CornerRadius="12" Padding="9,4"
                                    IsVisible="{Binding !IsEnabled}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="#98A2B3" />
                                <TextBlock Text="停用" Foreground="#667085" FontSize="12" />
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="1.8*" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !HasTypes}">
                  <TextBlock Text="暂无产品类型" FontSize="16" FontWeight="SemiBold"
                             Foreground="#526071" HorizontalAlignment="Center" />
                  <TextBlock Text="点击右上角“新增产品类型”开始配置" Classes="parameter-hint" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- 产品型号 -->
      <TabItem Classes="parameter-tab" IsVisible="{Binding CanManageProducts}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:AppIcon Kind="Product" Width="16" Height="16" Stroke="{DynamicResource BrandBlueBrush}" />
            <TextBlock Text="产品型号" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
          <Border Classes="parameter-surface" Padding="16,14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="parameter-icon">
                <icons:AppIcon Kind="Product" Width="20" Height="20" Stroke="{DynamicResource BrandBlueBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                  <TextBlock Text="产品型号" Classes="parameter-section-title" />
                  <TextBlock Text="按产品类型查看和维护具体型号"
                             Classes="parameter-hint" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="查看类型" Classes="parameter-label" VerticalAlignment="Center" />
                  <ComboBox Classes="parameter-input" Width="220"
                            ItemsSource="{Binding ModelTypeOptions}"
                            SelectedItem="{Binding SelectedModelType, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding Name}"
                            PlaceholderText="全部产品类型" />
                  <TextBlock Text="列表中的型号会随筛选实时更新" Classes="parameter-hint"
                             VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Center">
                <Border Classes="parameter-count">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Models.Count}" Foreground="{DynamicResource BrandBlueBrush}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="个型号" Classes="parameter-label" />
                  </StackPanel>
                </Border>
                <Button Classes="parameter-ghost" Content="启用 / 停用"
                        Click="OnToggleModelClick" IsEnabled="{Binding CanManageProducts}" />
                <Button Classes="parameter-secondary" Content="编辑"
                        Click="OnEditModelClick" IsEnabled="{Binding CanManageProducts}" />
                <Button Classes="parameter-danger" Content="删除"
                        Click="OnDeleteModelClick" IsEnabled="{Binding CanManageProducts}" />
                <Button Classes="parameter-primary" Click="OnAddModelClick" IsEnabled="{Binding CanManageProducts}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <icons:AppIcon Kind="Add" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" />
                    <TextBlock Text="新增产品型号" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="parameter-surface" Padding="1">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#F8FAFD" Padding="16,11"
                      BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="型号清单" FontWeight="SemiBold" Foreground="#344054" />
                  <TextBlock Grid.Column="1" Text="产品型号是试验记录与参数配置的最小业务单元"
                             Classes="parameter-hint" HorizontalAlignment="Right" />
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <DataGrid Classes="parameter-grid"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="类型编号" Binding="{Binding ProductTypeId}" Width="100" />
                    <DataGridTextColumn Header="型号编号" Binding="{Binding Id}" Width="1.2*" />
                    <DataGridTextColumn Header="型号名称" Binding="{Binding Name}" Width="1.4*" />
                    <DataGridTemplateColumn Header="状态" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid HorizontalAlignment="Left">
                            <Border Background="#ECFDF3" CornerRadius="12" Padding="9,4"
                                    IsVisible="{Binding IsEnabled}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="#18A654" />
                                <TextBlock Text="启用" Foreground="#087443" FontSize="12" />
                              </StackPanel>
                            </Border>
                            <Border Background="#F2F4F7" CornerRadius="12" Padding="9,4"
                                    IsVisible="{Binding !IsEnabled}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="#98A2B3" />
                                <TextBlock Text="停用" Foreground="#667085" FontSize="12" />
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="1.8*" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !HasModels}">
                  <TextBlock Text="暂无产品型号" FontSize="16" FontWeight="SemiBold"
                             Foreground="#526071" HorizontalAlignment="Center" />
                  <TextBlock Text="先创建产品类型，再点击右上角“新增产品型号”" Classes="parameter-hint" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- 试验项点 -->
      <TabItem Classes="parameter-tab" IsVisible="{Binding CanManageTestPoints}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:AppIcon Kind="Flow" Width="17" Height="17" Stroke="{DynamicResource BrandBlueBrush}" />
            <TextBlock Text="试验项点" />
          </StackPanel>
        </TabItem.Header>
        <views:TestPointManagementView DataContext="{Binding TestPointTab}" />
      </TabItem>

      <!-- 项点配置 -->
      <TabItem Classes="parameter-tab" IsVisible="{Binding CanManageTestPoints}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:AppIcon Kind="PointConfiguration" Width="17" Height="17" Stroke="{DynamicResource BrandBlueBrush}" />
            <TextBlock Text="项点配置" />
          </StackPanel>
        </TabItem.Header>
        <views:PointConfigurationView DataContext="{Binding PointConfigTab}" />
      </TabItem>

      <!-- 试验参数 -->
      <TabItem Classes="parameter-tab" IsVisible="{Binding CanManageTestDefinitions}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:AppIcon Kind="Settings" Width="17" Height="17" Stroke="{DynamicResource BrandBlueBrush}" />
            <TextBlock Text="试验参数" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
          <Border Classes="parameter-soft-surface" Padding="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Background="#F0F7FF" BorderBrush="#CFE0FF" BorderThickness="1"
                      CornerRadius="7" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="parameter-index">
                    <TextBlock Text="01" Foreground="{DynamicResource BrandBlueDarkBrush}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="项目级" FontWeight="SemiBold" Foreground="#164B95" />
                    <TextBlock Text="全局基础试验参数" Classes="parameter-hint" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#F8FAFD" BorderBrush="#E2E8F0" BorderThickness="1"
                      CornerRadius="7" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="parameter-index" Background="#F4F6F9">
                    <TextBlock Text="02" Foreground="#526071" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="产品级" FontWeight="SemiBold" Foreground="#344054" />
                    <TextBlock Text="按产品类型 + 产品型号维护" Classes="parameter-hint" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="0.82*,1.45*" ColumnSpacing="12">
            <Border Classes="parameter-surface" Padding="18">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="参数作用域" Classes="parameter-section-title" />
                  <TextBlock Text="自动试验读取项目参数和产品组合参数，修改操作统一在弹窗中完成。"
                             Classes="parameter-hint" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="parameter-index" Background="#F0F7FF">
                      <TextBlock Text="01" Foreground="{DynamicResource BrandBlueDarkBrush}"
                                 FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="项目级参数" FontWeight="SemiBold" />
                      <TextBlock Text="所有产品默认使用" Classes="parameter-hint" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="parameter-index" Background="#F4F6F9">
                      <TextBlock Text="02" Foreground="#526071" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="产品级参数" FontWeight="SemiBold" />
                      <TextBlock Text="由产品类型 + 产品型号共同确定" Classes="parameter-hint" />
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <Border Classes="parameter-note" Padding="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="编辑提示" Foreground="#164B95" FontWeight="SemiBold" />
                    <TextBlock Text="选择产品组合后点击“修改”打开弹窗，保存时统一校验两项产品参数。"
                               Foreground="#526071" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="0,0,4,0">
                <Border Classes="parameter-editor" Padding="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="parameter-index">
                      <TextBlock Text="01" Foreground="{DynamicResource BrandBlueDarkBrush}"
                                 FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <StackPanel Spacing="2">
                        <TextBlock Text="项目级参数" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="试验时间对所有产品生效" Classes="parameter-hint" />
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,190,Auto" ColumnSpacing="8">
                        <TextBlock Text="试验时间" Classes="parameter-label" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#F8FAFD" BorderBrush="#D9E2EC"
                                BorderThickness="1" CornerRadius="5" Padding="10,7">
                          <TextBlock Text="{Binding TestTimeInput}" Foreground="#344054" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="s" Classes="parameter-unit" />
                      </Grid>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="parameter-primary" Content="修改"
                            Click="OnEditProjectParameterClick"
                            IsEnabled="{Binding CanManageTestDefinitions}"
                            VerticalAlignment="Bottom" />
                  </Grid>
                </Border>

                <Border Classes="parameter-editor" Padding="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="parameter-index">
                      <TextBlock Text="02" Foreground="#526071" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <StackPanel Spacing="2">
                        <TextBlock Text="产品级参数" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="选择产品类型和产品型号，维护该型号的完整试验参数" Classes="parameter-hint" />
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto"
                            ColumnSpacing="8" RowSpacing="8">
                        <TextBlock Text="产品类型" Classes="parameter-label" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Classes="parameter-input"
                                  ItemsSource="{Binding ParamTypeOptions}"
                                  SelectedItem="{Binding SelectedParamType, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Name}"
                                  PlaceholderText="选择产品类型" />
                        <TextBlock Grid.Column="2" Text="产品型号" Classes="parameter-label"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3" Classes="parameter-input"
                                  ItemsSource="{Binding ParamModelOptions}"
                                  SelectedItem="{Binding SelectedParamModel, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Name}"
                                  PlaceholderText="选择产品型号" />
                        <TextBlock Grid.Row="1" Text="试验电压" Classes="parameter-label" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFD" BorderBrush="#D9E2EC"
                                BorderThickness="1" CornerRadius="5" Padding="10,7">
                          <TextBlock Text="{Binding TestVoltageInput}" Foreground="#344054" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="保护电流" Classes="parameter-label" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="3" Background="#F8FAFD" BorderBrush="#D9E2EC"
                                BorderThickness="1" CornerRadius="5" Padding="10,7">
                          <TextBlock Text="{Binding ProtectCurrentInput}" Foreground="#344054" />
                        </Border>
                      </Grid>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="parameter-primary" Content="修改"
                             Click="OnEditProductParameterClick"
                            IsEnabled="{Binding CanManageTestDefinitions}"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>

  </Grid>
</UserControl>
