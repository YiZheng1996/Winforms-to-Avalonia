<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        x:Class="XXX.TestBench.App.Views.PreparationGuidancePreviewWindow"
        x:DataType="vm:PreparationGuidancePreviewViewModel"
        Title="准备指导预览" Width="840" Height="720" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding GuidanceTitle}" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="{Binding ResourceSummary}" Foreground="#667085" TextWrapping="Wrap" />
      <TextBlock Text="预览只用于检查已导入内容；不会记录准备确认，也不会启用试验入口。"
                 Foreground="#9A6700" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PreparationGuidancePreviewViewModel+PreviewStep">
            <Border BorderBrush="#D6DEEA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Number, StringFormat='步骤 {0}'}" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{Binding ConfirmationText}" Foreground="#667085" />
                </Grid>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" MaxHeight="320" Stretch="Uniform" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="2" Content="关闭" HorizontalAlignment="Right" MinWidth="96" Click="OnCloseClick" />
  </Grid>
</Window>
