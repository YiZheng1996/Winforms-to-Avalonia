<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        xmlns:icons="using:XXX.TestBench.App.Icons"
        x:Class="XXX.TestBench.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding SystemName}"
        Width="1680" Height="945"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        UseLayoutRounding="True"
        Background="#F5F8FC">

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="60" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1B2432" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#EDF4FF" />
      <Setter Property="Foreground" Value="#0868F7" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.mode-choice">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#242B36" />
      <Setter Property="BorderBrush" Value="#D7DFEA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mode-choice.active">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
    </Style>
    <Style Selector="Button.test-action">
      <Setter Property="Height" Value="42" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.product-selector">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1B2432" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.product-selector:pointerover">
      <Setter Property="Background" Value="#EDF4FF" />
      <Setter Property="Foreground" Value="#0868F7" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="78,*">
    <!-- 顶部品牌与用户区 -->
    <Border x:Name="TopHeader" Grid.Row="0" Background="White" BorderBrush="#D6DEEA" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="420,*,470" Margin="20,0">
        <Image Grid.Column="0" Source="avares://XXX.TestBench.App/Assets/crrc-logo.png"
               Width="188" Height="62" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <TextBlock Grid.Column="1" Text="{Binding SystemName}" FontSize="34" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,24,Auto,Auto" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#0868F7" Margin="0,0,10,0">
            <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="当前用户：" FontSize="15" />
            <TextBlock Text="{Binding CurrentUserText}" FontSize="15" FontWeight="SemiBold" />
            <icons:AppIcon Kind="ChevronDown" Width="12" Height="12" Stroke="#5D6878" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="2" Width="1" Height="28" Background="#D6DEEA" HorizontalAlignment="Center" />
          <TextBlock x:Name="CurrentDateTextBlock" Grid.Column="3" Text="{Binding HeaderDateText}"
                     FontSize="15" VerticalAlignment="Center" Margin="10,0,18,0" />
          <TextBlock x:Name="CurrentTimeTextBlock" Grid.Column="4" Text="{Binding HeaderTimeText}"
                     FontSize="15" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <!-- 工艺主窗口的完整工控外壳 -->
    <Grid x:Name="ShellRoot" Grid.Row="1" ColumnDefinitions="178,*">
      <!-- 左侧导航 -->
      <Border Grid.Column="0" Background="White" BorderBrush="#D6DEEA" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LeftNavigation" ItemsSource="{Binding NavItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                  <Button Classes="nav" Classes.active="{Binding IsSelected}" Tag="{Binding}" Click="OnNavClick">
                    <Grid ColumnDefinitions="38,*" ColumnSpacing="8">
                      <icons:AppIcon Grid.Column="0" Kind="{Binding Icon}" Width="24" Height="24"
                                     Stroke="{Binding $parent[Button].Foreground}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="16"
                                 Foreground="{Binding $parent[Button].Foreground}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Grid Grid.Row="1" RowDefinitions="1,48">
            <Border Grid.Row="0" Background="#E1E7EF" Margin="18,0" />
            <Button x:Name="ExitButton" Grid.Row="1" Classes="nav" Click="OnExitClick" Height="48"
                    Padding="18,0" Background="Transparent" AutomationProperties.Name="退出系统">
              <Grid ColumnDefinitions="38,*" ColumnSpacing="8">
                <icons:AppIcon Kind="Logout" Width="22" Height="22" Stroke="#0868F7"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="退出系统" FontSize="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- 产品、业务内容、控制条、底部状态 -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">
        <Border x:Name="ProductInfoBar" Grid.Row="0" IsVisible="{Binding IsOverviewPage}"
                MinHeight="70" Background="White" BorderBrush="#D6DEEA" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="2.2*,1.0*,1.1*,1.5*,0.7*,0.5*">
            <Button Grid.Column="0" Classes="product-selector" Click="OnProductSelectorClick">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,12,0">
                <TextBlock Text="产品选择：" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentProductModelNameText}" FontSize="16"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                <Border Grid.Column="2" Width="116" Height="42" Margin="10,0,0,0"
                        Background="White" BorderBrush="#0868F7" BorderThickness="1" CornerRadius="3"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="选择型号" Foreground="#0868F7" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <icons:AppIcon Kind="ChevronRight" Width="14" Height="14" Stroke="#0868F7"
                                  VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Button>
            <Border Grid.Column="1" BorderBrush="#E1E6ED" BorderThickness="1,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="车型：" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentProductTypeText}" FontSize="16" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="6,0" VerticalAlignment="Center">
              <TextBlock Text="产品型号：" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentProductModelText}" FontSize="16" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="6,0" VerticalAlignment="Center">
              <TextBlock Text="产品编号：" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentProductNumberText}" FontSize="16" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="6,0" VerticalAlignment="Center">
              <TextBlock Text="车号：" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="020501" FontSize="16" />
            </StackPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="4,0" VerticalAlignment="Center">
              <TextBlock Text="备注：" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="—" FontSize="16" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="WorkspaceRegion" Grid.Row="1" Background="#F5F8FC" Padding="12">
          <ContentControl Content="{Binding CurrentPage}" />
        </Border>

        <Border x:Name="BottomControlBar" Grid.Row="2" IsVisible="{Binding IsOverviewPage}" MinHeight="76" Background="White" BorderBrush="#D6DEEA" BorderThickness="1,1,0,0" Padding="14,4">
          <Grid ColumnDefinitions="1.35*,1.45*,1.25*,0.8*,0.8*">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*,*" VerticalAlignment="Center">
              <TextBlock Text="控制模式：" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,4,0" />
              <Button Grid.Column="1" Classes="mode-choice" Margin="0,0,4,0" Padding="6,0" FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <icons:AppIcon Kind="Manual" Width="16" Height="16"
                                Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                  <TextBlock Text="手动控制" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="mode-choice active" Padding="6,0" FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <icons:AppIcon Kind="Automatic" Width="16" Height="16"
                                Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                  <TextBlock Text="自动控制" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Grid.Column="1" BorderBrush="#D7DFEA" BorderThickness="1,0,0,0" Margin="16,0,0,0">
              <Grid ColumnDefinitions="Auto,*" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="当前提示：" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                <TextBlock Grid.Column="1" Text="试验测试2 - 制动缓解  进行中..." Foreground="#0868F7"
                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D7DFEA" BorderThickness="1,0,0,0">
              <Grid ColumnDefinitions="Auto,*" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="试验时间：" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="00:12:48" Foreground="#0868F7" FontFamily="Consolas"
                           FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Column="3" BorderBrush="#D7DFEA" BorderThickness="1,0,0,0">
              <Button Classes="test-action" Background="#C9D0DB" Foreground="White" BorderThickness="0"
                      IsHitTestVisible="False" Focusable="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <icons:AppIcon Kind="Play" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="开始试验" />
                </StackPanel>
              </Button>
            </Border>
            <Button Grid.Column="4" Classes="test-action" Background="#F5222D" Foreground="White" BorderThickness="0"
                    Tag="试验执行" Click="OnNavigateToTitleClick">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <icons:AppIcon Kind="Stop" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" />
                <TextBlock Text="结束试验" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Border x:Name="StatusBar" Grid.Row="3" MinHeight="48" Background="White"
                BorderBrush="#D6DEEA" BorderThickness="0,1,0,0"
                AutomationProperties.Name="设备与安全状态">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="56" Margin="0,0,34,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <icons:AppIcon Kind="Connection" Width="20" Height="20" Stroke="#18A654" />
              <TextBlock Text="{Binding ConnectionDisplayText}" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="22" Height="22" Background="#20A65A" CornerRadius="5">
                <icons:AppIcon Kind="Check" Width="12" Height="12" Stroke="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="急停回路正常" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <icons:AppIcon Kind="DeviceMode" Width="20" Height="20" Stroke="#0868F7" />
              <TextBlock x:Name="ModeTextBlock" Text="{Binding DeviceModeDisplayText}" Foreground="#0868F7"
                         FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- 弹窗遮罩：弹窗打开期间压暗主界面，突出当前弹窗并阻断底层点击 -->
    <Border x:Name="DialogOverlay" Grid.RowSpan="2" Background="#66000000"
            IsVisible="False" IsHitTestVisible="True" ZIndex="30"
            AutomationProperties.Name="弹窗背景遮罩" />

    <!-- 故障横幅 -->
    <Border Grid.RowSpan="2" Background="#E5484D" Padding="18,12" CornerRadius="4"
            HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="18"
            x:Name="FaultBanner" IsVisible="{Binding IsFaulted}" ZIndex="20">
      <StackPanel Spacing="4">
        <TextBlock Text="启动故障（Faulted）" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="{Binding FaultMessage}" Foreground="White" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
