<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        xmlns:views="using:XXX.TestBench.App.Views"
        x:Class="XXX.TestBench.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding SystemName}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- 顶栏 -->
    <Border DockPanel.Dock="Top" Background="#2B579A" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="{Binding SystemName}" FontSize="18" FontWeight="Bold"
                   Foreground="White" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#1E8449" CornerRadius="4" Padding="8,3">
            <TextBlock x:Name="ModeTextBlock" Text="{Binding DeviceModeText}" Foreground="White" FontSize="12" />
          </Border>
          <TextBlock Text="{Binding ConnectionStatusText}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentUserText}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
          <Button Content="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthenticated}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底部状态区 -->
    <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="12,5">
      <TextBlock Text="{Binding BottomStatusText}" FontSize="11" Foreground="#404040" />
    </Border>

    <!-- 左侧主导航 -->
    <Border DockPanel.Dock="Left" Width="180" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0"
            IsVisible="{Binding IsAuthenticated}">
      <ListBox ItemsSource="{Binding NavItems}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationItemViewModel">
            <Button Content="{Binding Title}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Tag="{Binding}" Click="OnNavClick" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- 主内容区 -->
    <Panel>
      <views:LoginView IsVisible="{Binding !IsAuthenticated}" />
      <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding IsAuthenticated}" />

      <!-- 故障横幅 -->
      <Border Background="#E74C3C" Padding="16,10" CornerRadius="4"
              HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16"
              x:Name="FaultBanner" IsVisible="{Binding IsFaulted}">
        <StackPanel Spacing="4">
          <TextBlock Text="启动故障（Faulted）" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="{Binding FaultMessage}" Foreground="White" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</Window>
