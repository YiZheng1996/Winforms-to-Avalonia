<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        x:Class="XXX.TestBench.App.Views.ConfirmDialogWindow"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="480" Height="290"
        MinWidth="440" MinHeight="260"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        UseLayoutRounding="True">
  <Window.Styles>
    <Style Selector="Button.dialog-secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#C9D3E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="Button.dialog-danger">
      <Setter Property="Background" Value="#F5222D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#F5222D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
  </Window.Styles>
  <Border Background="White" BorderBrush="#C9D3E0" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="#FFF8F7" BorderBrush="#F2D0CB" BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0" Padding="24,14" PointerPressed="OnTitleBarPointerPressed">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#9F2D25" />
      </Border>
      <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="24,24" TextWrapping="Wrap"
                 Foreground="#344054" FontSize="15" VerticalAlignment="Center" />
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,0,24,20">
        <Button Classes="dialog-secondary" Content="取消" Click="OnCancelClick" />
        <Button Classes="dialog-danger" Content="{Binding ConfirmText}" Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
