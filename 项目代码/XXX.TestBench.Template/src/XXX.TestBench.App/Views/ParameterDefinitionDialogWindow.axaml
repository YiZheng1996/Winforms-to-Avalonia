<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        x:Class="XXX.TestBench.App.Views.ParameterDefinitionDialogWindow"
        x:DataType="vm:ParameterDefinitionDialogViewModel"
        Title="新增参数"
        Width="620"
        Height="680"
        MinWidth="560"
        MinHeight="580"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#F5F8FC"
        UseLayoutRounding="True">
  <Window.Styles>
    <Style Selector="Button.dialog-secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#C9D3E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="Button.dialog-primary">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
  </Window.Styles>

  <Border Margin="18" Padding="24" Background="White" BorderBrush="#D6DEEA" BorderThickness="1" CornerRadius="4">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="新增参数" FontSize="22" FontWeight="Bold" Foreground="#151A24" />
        <TextBlock Text="参数定义归属于试验项，保存后会显示在参数列表中" Foreground="#667085" FontSize="13" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,16">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="所属试验项" FontWeight="SemiBold" Foreground="#344054" />
            <ComboBox ItemsSource="{Binding ItemOptions}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"
                      PlaceholderText="请选择试验项" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="参数代码" FontWeight="SemiBold" Foreground="#344054" />
              <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="唯一代码" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="参数名称" FontWeight="SemiBold" Foreground="#344054" />
              <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="显示名称" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="数据类型" FontWeight="SemiBold" Foreground="#344054" />
              <ComboBox ItemsSource="{Binding DataTypeOptions}"
                        SelectedItem="{Binding SelectedDataType, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="单位" FontWeight="SemiBold" Foreground="#344054" />
              <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="例如：MPa、kV" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="下限" FontWeight="SemiBold" Foreground="#344054" />
              <TextBox Text="{Binding MinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="可选" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="上限" FontWeight="SemiBold" Foreground="#344054" />
              <TextBox Text="{Binding MaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="可选" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="小数精度" FontWeight="SemiBold" Foreground="#344054" />
              <TextBox Text="{Binding Precision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="可选，非负整数" />
            </StackPanel>
            <CheckBox Grid.Column="1" Content="必填参数" IsChecked="{Binding IsRequired, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,24,0,0" />
          </Grid>

          <StackPanel IsVisible="{Binding IsEnum}" Spacing="6">
            <TextBlock Text="枚举可选值" FontWeight="SemiBold" Foreground="#344054" />
            <TextBox Text="{Binding AllowedValues, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="用逗号分隔，例如：自动,手动" />
          </StackPanel>

          <TextBlock Text="{Binding ValidationMessage}" Foreground="#D92D20" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="dialog-secondary" Content="取消" Click="OnCancelClick" />
        <Button Classes="dialog-primary" Content="保存" IsEnabled="{Binding CanSave}" Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
