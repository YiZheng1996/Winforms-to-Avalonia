<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels"
             x:Class="XXX.TestBench.App.Views.ParameterManagementView"
             x:DataType="vm:ParameterManagementViewModel">
  <UserControl.Styles>
    <Style Selector="Border.recipe-card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D6DEEA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBlock.recipe-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#151A24" />
    </Style>
    <Style Selector="TextBlock.recipe-caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#667085" />
    </Style>
  </UserControl.Styles>

  <Grid Background="#F5F8FC" RowDefinitions="Auto,*,Auto" Margin="16">
    <Border Grid.Row="0" Classes="recipe-card" Padding="18,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="参数管理" Classes="recipe-title" />
          <TextBlock Text="产品类型、产品型号与代码固定的试验参数" Classes="recipe-caption" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新数据" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="产品类型">
        <DockPanel Margin="8" LastChildFill="True">
          <Border DockPanel.Dock="Top" Classes="recipe-card" Padding="14" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="产品类型列表" Classes="recipe-title" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="当前数量：" Classes="recipe-caption" />
                  <TextBlock Text="{Binding Types.Count}" Foreground="#0868F7" FontWeight="SemiBold" />
                  <TextBlock Text="个" Classes="recipe-caption" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="停用/启用选中" Command="{Binding DisableSelectedTypeCommand}" />
                <Button Content="新增产品类型" Click="OnAddTypeClick" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid>
            <DataGrid ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="42" MinHeight="240">
              <DataGrid.Columns>
                <DataGridTextColumn Header="类型代码" Binding="{Binding Code}" Width="1*" />
                <DataGridTextColumn Header="类型名称" Binding="{Binding Name}" Width="1.5*" />
                <DataGridTextColumn Header="启用状态" Binding="{Binding IsEnabled}" Width="120" />
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="暂无产品类型，请点击“新增产品类型”创建。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#98A2B3" IsVisible="{Binding !HasTypes}" />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="产品型号">
        <DockPanel Margin="8" LastChildFill="True">
          <Border DockPanel.Dock="Top" Classes="recipe-card" Padding="14" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="8">
                <TextBlock Text="产品型号列表" Classes="recipe-title" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="所属类型：" Classes="recipe-caption" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ModelTypeOptions}"
                            SelectedItem="{Binding SelectedModelType, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding Name}"
                            PlaceholderText="全部产品类型" Width="220" />
                  <TextBlock Text="当前数量：" Classes="recipe-caption" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Models.Count}" Foreground="#0868F7" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="个" Classes="recipe-caption" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="停用/启用选中" Command="{Binding DisableSelectedModelCommand}" />
                <Button Content="新增产品型号" Click="OnAddModelClick" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid>
            <DataGrid ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="42" MinHeight="240">
              <DataGrid.Columns>
                <DataGridTextColumn Header="类型编号" Binding="{Binding ProductTypeId}" Width="100" />
                <DataGridTextColumn Header="型号代码" Binding="{Binding Code}" Width="1.2*" />
                <DataGridTextColumn Header="型号名称" Binding="{Binding Name}" Width="1.5*" />
                <DataGridTextColumn Header="启用状态" Binding="{Binding IsEnabled}" Width="120" />
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="暂无产品型号，请先创建产品类型，再点击“新增产品型号”。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#98A2B3" IsVisible="{Binding !HasModels}" />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="试验参数">
        <DockPanel Margin="8" LastChildFill="True">
          <Border DockPanel.Dock="Top" Classes="recipe-card" Padding="14" Margin="0,0,0,10">
            <StackPanel Spacing="4">
              <TextBlock Text="试验参数（代码固定字段）" Classes="recipe-title" />
              <TextBlock Text="参数按 项目 / 产品类型 / 产品型号 三级保存，自动试验读取合并后的强类型参数。" Classes="recipe-caption" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="10">
            <Border Classes="recipe-card" Padding="14">
              <Grid ColumnDefinitions="Auto,200,*,Auto">
                <TextBlock Text="项目参数" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="试验时间 (s)：" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding TestTimeInput, Mode=TwoWay}" Watermark="1～3600" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="保存项目参数" Command="{Binding SaveProjectParameterCommand}" Margin="12,0,0,0" />
              </Grid>
            </Border>
            <Border Classes="recipe-card" Padding="14">
              <Grid ColumnDefinitions="Auto,180,200,*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.RowSpan="2" Text="类型参数" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="产品类型：" VerticalAlignment="Center" Margin="0,0,0,6" />
                <ComboBox Grid.Column="2" Grid.Row="0" ItemsSource="{Binding ParamTypeOptions}"
                          SelectedItem="{Binding SelectedParamType, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Name}" PlaceholderText="选择产品类型" Margin="0,0,0,6" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="试验电压 (V)：" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Grid.Row="1" Text="{Binding TestVoltageInput, Mode=TwoWay}" Watermark="0～5000" VerticalAlignment="Center" />
                <Button Grid.Column="4" Grid.RowSpan="2" Content="保存类型参数" Command="{Binding SaveTypeParameterCommand}" Margin="12,0,0,0" />
              </Grid>
            </Border>
            <Border Classes="recipe-card" Padding="14">
              <Grid ColumnDefinitions="Auto,180,220,Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.RowSpan="3" Text="型号参数" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="产品类型：" VerticalAlignment="Center" Margin="0,0,0,6" />
                <ComboBox Grid.Column="2" Grid.Row="0" ItemsSource="{Binding ParamTypeOptions}"
                          SelectedItem="{Binding SelectedParamType, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Name}" PlaceholderText="选择产品类型" Margin="0,0,0,6" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="产品型号：" VerticalAlignment="Center" Margin="0,0,0,6" />
                <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding ParamModelOptions}"
                          SelectedItem="{Binding SelectedParamModel, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Name}" PlaceholderText="选择产品型号" Margin="0,0,0,6" />
                <TextBlock Grid.Column="1" Grid.Row="2" Text="保护电流 (mA)：" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding ProtectCurrentInput, Mode=TwoWay}" Watermark="0～1000" VerticalAlignment="Center" />
                <Button Grid.Column="3" Grid.Row="2" Content="保存型号参数" Command="{Binding SaveModelParameterCommand}" Margin="12,0,0,0" />
              </Grid>
            </Border>
          </StackPanel>
        </DockPanel>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#1F618D" Margin="4,8,4,0" TextWrapping="Wrap" />
  </Grid>
</UserControl>
