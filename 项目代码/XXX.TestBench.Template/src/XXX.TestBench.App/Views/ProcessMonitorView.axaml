<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels"
             x:Class="XXX.TestBench.App.Views.ProcessMonitorView"
             x:DataType="vm:ProcessMonitorViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="刷新" Command="{Binding RefreshCommand}" />
      <ComboBox ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" Width="200" DisplayMemberBinding="{Binding Code}" />
      <TextBox Text="{Binding WriteValue}" Watermark="写入值" Width="120" />
      <CheckBox Content="高风险已确认" IsChecked="{Binding RiskConfirmed}" VerticalAlignment="Center" />
      <Button Content="写入（走安全链）" Command="{Binding WriteCommand}" IsEnabled="{Binding CanWriteSelectedPoint}" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="#1F618D" VerticalAlignment="Center" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="42" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="点位代码" Binding="{Binding Code}" Width="1.2*" />
        <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="1.2*" />
        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="1.2*" />
        <DataGridTextColumn Header="可写" Binding="{Binding IsWritable}" Width="80" />
        <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="110" />
        <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="1.2*" />
        <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="110" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
