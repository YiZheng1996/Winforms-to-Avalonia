<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels"
             xmlns:process="using:XXX.TestBench.App.Controls.Process"
             x:Class="XXX.TestBench.App.Views.ProcessMonitorView"
             x:DataType="vm:ProcessMonitorViewModel"
             UseLayoutRounding="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.process-secondary">
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.process-action">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0868F7" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.process-primary">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
    </Style>
    <Style Selector="Border.process-card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D6DEEA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid MinWidth="1000" RowDefinitions="56,390,Auto,44" RowSpacing="10">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="工艺监控" FontSize="24" FontWeight="Bold" Foreground="#151A24" />
          <TextBlock Text="{Binding RuntimeStatusText}" Classes="process-secondary" />
        </StackPanel>
        <Button Grid.Column="1" Classes="process-action" Content="刷新"
                Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新工艺缓存" />
        <Button Grid.Column="2" Classes="process-action process-primary" Content="点位绑定"
                IsVisible="{Binding CanManageProcessBindings}" Click="OnPointBindingsClick"
                AutomationProperties.Name="打开工艺点位绑定" />
      </Grid>

      <process:PneumaticDiagramControl Grid.Row="1" Model="{Binding Diagram}" />

      <Grid x:Name="CardGridWide" Grid.Row="2" Height="224" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
        <Border Grid.Column="0" Classes="process-card">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="状态反馈" FontSize="17" FontWeight="SemiBold" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
              <process:DigitalInputControl Model="{Binding SafetyDoor}" />
              <process:DigitalInputControl Grid.Column="1" Model="{Binding ClampReady}" />
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Column="1" Classes="process-card">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="阀门控制" FontSize="17" FontWeight="SemiBold" />
            <Grid Grid.Row="1" RowDefinitions="*,*" RowSpacing="6">
              <process:DigitalOutputControl Model="{Binding InletValve}" />
              <process:DigitalOutputControl Grid.Row="1" Model="{Binding ExhaustValve}" />
            </Grid>
          </Grid>
        </Border>
        <process:AnalogInputControl Grid.Column="2" Model="{Binding MainPressure}" />
        <process:AnalogOutputControl Grid.Column="3" Model="{Binding PressureSetpoint}" />
      </Grid>

      <Grid x:Name="CardGridCompact" Grid.Row="2" Height="458" RowDefinitions="224,224" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10"
            IsVisible="False">
        <Border Grid.Row="0" Grid.Column="0" Classes="process-card">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="状态反馈" FontSize="17" FontWeight="SemiBold" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
              <process:DigitalInputControl Model="{Binding SafetyDoor}" />
              <process:DigitalInputControl Grid.Column="1" Model="{Binding ClampReady}" />
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Classes="process-card">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="阀门控制" FontSize="17" FontWeight="SemiBold" />
            <Grid Grid.Row="1" RowDefinitions="*,*" RowSpacing="6">
              <process:DigitalOutputControl Model="{Binding InletValve}" />
              <process:DigitalOutputControl Grid.Row="1" Model="{Binding ExhaustValve}" />
            </Grid>
          </Grid>
        </Border>
        <process:AnalogInputControl Grid.Row="1" Grid.Column="0" Model="{Binding MainPressure}" />
        <process:AnalogOutputControl Grid.Row="1" Grid.Column="1" Model="{Binding PressureSetpoint}" />
      </Grid>

      <Border Grid.Row="3" Background="White" BorderBrush="#D6DEEA" BorderThickness="1" CornerRadius="6" Padding="12,0">
        <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <TextBlock Text="状态图例" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="12" Height="12" Fill="#18A654" />
            <TextBlock Text="有效" Classes="process-secondary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="12" Height="12" Fill="#F59E0B" />
            <TextBlock Text="陈旧/等待" Classes="process-secondary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="12" Height="12" Fill="#F5222D" />
            <TextBlock Text="无效/断开" Classes="process-secondary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="12" Height="12" Fill="#98A2B3" />
            <TextBlock Text="未知/未绑定" Classes="process-secondary" />
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" Classes="process-secondary" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
