<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        x:Class="XXX.TestBench.App.Views.ProductModelSelectionWindow"
        x:DataType="vm:ProductModelSelectionViewModel"
        Title="选择产品型号"
        Width="860"
        Height="600"
        MinWidth="700"
        MinHeight="480"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        UseLayoutRounding="True">
  <Window.Styles>
    <Style Selector="Button.dialog-secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#C9D3E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="Button.dialog-primary">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
  </Window.Styles>

  <Border Margin="0" Padding="0" Background="White" BorderBrush="#C9D3E0" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Border Grid.Row="0"
              Background="#F8FAFD"
              BorderBrush="#E4EAF2"
              BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0"
              Padding="24,12"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*">
          <StackPanel Spacing="2">
            <TextBlock Text="选择产品型号" FontSize="20" FontWeight="Bold" Foreground="#151A24" />
            <TextBlock Text="选择后将同步到工艺界面的产品信息栏" Foreground="#667085" FontSize="12" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="24,18,24,10">
        <TextBlock Text="当前可选型号：" Foreground="#667085" VerticalAlignment="Center" />
        <TextBlock Text="{Binding OptionCount}" Foreground="#0868F7" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="个" Foreground="#667085" VerticalAlignment="Center" />
      </StackPanel>

      <Grid Grid.Row="2" Margin="24,0,24,0">
        <DataGrid ItemsSource="{Binding Options}"
                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="42">
          <DataGrid.Columns>
            <DataGridTextColumn Header="产品类型" Binding="{Binding TypeDisplay}" Width="1.2*" />
            <DataGridTextColumn Header="型号编号" Binding="{Binding ProductModelId}" Width="1*" />
            <DataGridTextColumn Header="型号名称" Binding="{Binding ProductModelName}" Width="1.3*" />
            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="暂无可选型号，请先在参数管理中新增产品类型和产品型号。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#98A2B3"
                   IsVisible="{Binding !HasOptions}" />
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,18,24,20">
        <Button Classes="dialog-secondary" Content="取消" Click="OnCancelClick" />
        <Button Classes="dialog-primary" Content="确定" IsEnabled="{Binding CanConfirm}" Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
