<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.App.ViewModels"
             x:Class="XXX.TestBench.App.Views.TaskManagementView"
             x:DataType="vm:TaskManagementViewModel">
  <DockPanel Margin="16" LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="刷新" Command="{Binding LoadCommand}" />
      <Button Content="新建任务" Command="{Binding NewTaskCommand}" />
      <Button Content="取消选中任务" Command="{Binding CancelSelectedCommand}" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="#1F618D" VerticalAlignment="Center" />
    </StackPanel>
    <Border DockPanel.Dock="Top" IsVisible="{Binding ShowNewTask}" Margin="0,0,0,8" Background="#FDF2E9" Padding="10"><StackPanel Spacing="6">
      <TextBlock Text="新建任务" FontWeight="Bold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding SelectedType}" Width="160" DisplayMemberBinding="{Binding Name}" />
        <ComboBox ItemsSource="{Binding ProductModels}" SelectedItem="{Binding SelectedModel}" Width="160" DisplayMemberBinding="{Binding Name}" />
        <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" Width="220" DisplayMemberBinding="{Binding Name}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding ProductNumber}" Watermark="产品编号" Width="140" />
        <TextBox Text="{Binding BatchNumber}" Watermark="批次号" Width="140" />
        <TextBox Text="{Binding StationNumber}" Watermark="工位号" Width="140" />
        <TextBox Text="{Binding Remark}" Watermark="备注" Width="200" />
        <Button Content="创建" Command="{Binding CreateTaskCommand}" />
      </StackPanel>
    </StackPanel></Border>
    <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTaskRow}" AutoGenerateColumns="True" IsReadOnly="True" />
  </DockPanel>
</UserControl>
