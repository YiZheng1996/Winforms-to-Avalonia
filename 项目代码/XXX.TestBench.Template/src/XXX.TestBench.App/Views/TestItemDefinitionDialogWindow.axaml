<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        x:Class="XXX.TestBench.App.Views.TestItemDefinitionDialogWindow"
        x:DataType="vm:TestItemDefinitionDialogViewModel"
        Title="新增试验项"
        Width="520"
        Height="450"
        MinWidth="480"
        MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#F5F8FC"
        UseLayoutRounding="True">
  <Window.Styles>
    <Style Selector="Button.dialog-secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#C9D3E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="Button.dialog-primary">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
  </Window.Styles>

  <Border Margin="18" Padding="24" Background="White" BorderBrush="#D6DEEA" BorderThickness="1" CornerRadius="4">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="新增试验项" FontSize="22" FontWeight="Bold" Foreground="#151A24" />
        <TextBlock Text="填写试验项定义和已注册的执行器代码" Foreground="#667085" FontSize="13" />
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="12" Margin="0,24,0,18">
        <StackPanel Spacing="6">
          <TextBlock Text="试验项代码" FontWeight="SemiBold" Foreground="#344054" />
          <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="请输入唯一代码" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="试验项名称" FontWeight="SemiBold" Foreground="#344054" />
          <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="可选，留空时使用代码" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="执行器代码" FontWeight="SemiBold" Foreground="#344054" />
          <TextBox Text="{Binding ExecutorCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="例如：PressureExecutor" />
        </StackPanel>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="#D92D20" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="dialog-secondary" Content="取消" Click="OnCancelClick" />
        <Button Classes="dialog-primary" Content="保存" IsEnabled="{Binding CanSave}" Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
