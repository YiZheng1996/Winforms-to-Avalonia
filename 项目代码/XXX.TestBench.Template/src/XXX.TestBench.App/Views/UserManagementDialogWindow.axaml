<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.App.ViewModels"
        x:Class="XXX.TestBench.App.Views.UserManagementDialogWindow"
        x:DataType="vm:UserManagementDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="620" Height="520"
        MinWidth="560" MinHeight="460"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        UseLayoutRounding="True">
  <Window.Styles>
    <Style Selector="Button.dialog-secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#C9D3E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="Button.dialog-primary">
      <Setter Property="Background" Value="#0868F7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0868F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#344054" />
    </Style>
    <Style Selector="TextBox.field-input">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="ComboBox.field-input">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Window.Styles>

  <Border Background="White" BorderBrush="#C9D3E0" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="#F8FAFD" BorderBrush="#E4EAF2" BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0" Padding="24,14" PointerPressed="OnTitleBarPointerPressed">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="#151A24" />
          <TextBlock Text="{Binding DialogSubtitle}" Foreground="#667085" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="24,22,24,18">
          <StackPanel Spacing="6">
            <TextBlock Text="登录账号 *" Classes="field-label" />
            <TextBox Classes="field-input" Text="{Binding LoginName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditLoginName}" Watermark="请输入登录账号" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="显示名称 *" Classes="field-label" />
            <TextBox Classes="field-input" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="请输入姓名或岗位名称" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="所属角色 *" Classes="field-label" />
            <ComboBox Classes="field-input" ItemsSource="{Binding RoleOptions}"
                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}" PlaceholderText="请选择角色" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding ShowPasswordFields}">
            <StackPanel Spacing="6">
              <TextBlock Text="初始密码 *" Classes="field-label" />
              <TextBox Classes="field-input" Text="{Binding TemporaryPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="●" Watermark="请输入临时密码" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="确认密码 *" Classes="field-label" />
              <TextBox Classes="field-input" Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="●" Watermark="请再次输入" />
            </StackPanel>
          </Grid>
          <CheckBox Content="启用账号" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeStatus}" />
          <TextBlock Text="{Binding ValidationMessage}" Foreground="#D92D20" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,0,24,20">
        <Button Classes="dialog-secondary" Content="取消" Click="OnCancelClick" />
        <Button Classes="dialog-primary" Content="保存" IsEnabled="{Binding CanSave}" Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
