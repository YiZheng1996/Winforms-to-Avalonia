<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.Avalonia.ViewModels"
        x:Class="XXX.TestBench.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="XXX 试验台 - UOS"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <Border Grid.Row="0" Padding="16" CornerRadius="8" Background="#16324F">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="XXX 试验台" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Avalonia / UOS 只读迁移切片" Foreground="#D5E7F7" />
        </StackPanel>
        <Border Grid.Column="1" Margin="12,0,0,0" Padding="12,8" CornerRadius="5" Background="#234E70">
          <StackPanel Spacing="2">
            <TextBlock Text="连接状态" FontSize="12" Foreground="#B7D7EC" />
            <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" Foreground="White" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="12,0,0,0" Padding="12,8" CornerRadius="5" Background="#234E70">
          <StackPanel Spacing="2">
            <TextBlock Text="试验状态" FontSize="12" Foreground="#B7D7EC" />
            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="White" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                   Text="{Binding SafetyText}"
                   Foreground="#FFE7A3"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,16" ColumnDefinitions="310,16,*">
      <Border Grid.Column="0" Padding="16" CornerRadius="8" BorderBrush="#D0D7DE" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock Text="试验流程" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding WorkflowText}" TextWrapping="Wrap" Foreground="#4B5563" />

            <TextBlock Text="产品标识" Classes="caption" />
            <TextBox x:Name="ProductIdInput"
                     Text="{Binding ProductId, Mode=TwoWay}"
                     Watermark="输入产品标识"
                     AutomationProperties.Name="产品标识输入框" />
            <Button Content="选择产品"
                    Command="{Binding SelectProductCommand}"
                    IsEnabled="{Binding CanSelectProduct}"
                    AutomationProperties.Name="选择产品" />

            <Button x:Name="LoginButton"
                    Content="进入仿真会话"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding CanLogin}"
                    AutomationProperties.Name="进入仿真会话" />
            <Button x:Name="RefreshButton"
                    Content="刷新只读数据"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}"
                    AutomationProperties.Name="刷新只读数据" />

            <Border Padding="10" CornerRadius="5" Background="#F4F7FA">
              <StackPanel Spacing="6">
                <TextBlock Text="运行方式" Classes="caption" />
                <TextBlock Text="{Binding TransportModeText}" />
                <TextBlock Text="{Binding TestModeText}" />
                <TextBlock Text="{Binding WritesText}" Foreground="#A33A2B" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Text="核心命令" FontSize="16" FontWeight="SemiBold" />
            <Button Content="启动自动试验"
                    Command="{Binding StartAutomaticTestCommand}"
                    IsEnabled="{Binding CanStartAutomaticTest}"
                    AutomationProperties.Name="启动自动试验" />
            <Button Content="进入手动模式"
                    Command="{Binding EnterManualCommand}"
                    IsEnabled="{Binding CanEnterManual}"
                    AutomationProperties.Name="进入手动模式" />
            <Button Content="请求停止"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding CanStop}"
                    AutomationProperties.Name="请求停止" />
            <Button Content="故障恢复"
                    Command="{Binding RecoverFaultCommand}"
                    IsEnabled="{Binding CanRecoverFault}"
                    AutomationProperties.Name="故障恢复" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Padding="16" CornerRadius="8" BorderBrush="#D0D7DE" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="首条只读业务切片" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="压力调整阀 B11 / P2 五点" Foreground="#4B5563" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding LastSampleText}" VerticalAlignment="Center" Foreground="#4B5563" />
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,14,0,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Points}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PointDisplayViewModel">
                  <Border Margin="0,0,0,8" Padding="12" CornerRadius="5" Background="#F8FAFC">
                    <Grid ColumnDefinitions="230,*,105,90,70" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="{Binding PointId}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#4B5563" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="{Binding QualityText}" HorizontalAlignment="Center" Foreground="{Binding QualityColor}" />
                       <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                         <TextBlock Text="#" Foreground="#4B5563" />
                         <TextBlock Text="{Binding ConnectionGeneration}" Foreground="#4B5563" />
                       </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding DetailText}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="2" Padding="10" CornerRadius="5" Background="#FFF8E1">
            <TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap" AutomationProperties.Name="运行反馈" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
      <TextBlock Text="{Binding ConfigText}" Foreground="#4B5563" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="{Binding LastLogText}" Foreground="#4B5563" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Window>
