<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XXX.TestBench.Avalonia.ViewModels"
        xmlns:views="using:XXX.TestBench.Avalonia.Views"
        x:Class="XXX.TestBench.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppTitle}"
        Width="1440"
        Height="860"
        MinWidth="960"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="overview" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="test" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="process" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="management" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="reports" />
    <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="calibration" />
    <KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateCommand}" CommandParameter="diagnostics" />
    <KeyBinding Gesture="Ctrl+8" Command="{Binding NavigateCommand}" CommandParameter="instrument" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Border Grid.Row="0" Padding="14" CornerRadius="8" Background="#16324F">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="{Binding AppTitle}" FontSize="25" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="{Binding SelectedPageTitle}" Foreground="#D5E7F7" FontSize="16" />
        </StackPanel>
        <Border Grid.Column="1" Margin="12,0,0,0" Padding="12,7" CornerRadius="5" Background="#234E70">
          <StackPanel Spacing="2">
            <TextBlock Text="连接状态" FontSize="12" Foreground="#B7D7EC" />
            <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" Foreground="White" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="12,0,0,0" Padding="12,7" CornerRadius="5" Background="#234E70">
          <StackPanel Spacing="2">
            <TextBlock Text="试验状态" FontSize="12" Foreground="#B7D7EC" />
            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="White" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,9,0,0"
                   Text="{Binding SafetyText}" Foreground="#FFE7A3" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,12" ColumnDefinitions="238,12,*">
      <Border Grid.Column="0" Padding="10" CornerRadius="8" BorderBrush="#D0D7DE" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="6,4,6,10" Spacing="3">
            <TextBlock Text="功能导航" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Ctrl+1 ～ Ctrl+8" Classes="caption" />
          </StackPanel>
          <ListBox x:Name="NavigationList" Grid.Row="1"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                   SelectionMode="Single"
                   AutomationProperties.Name="主功能导航">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItemViewModel">
                <StackPanel Margin="4,7" MinHeight="44" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Padding="14" CornerRadius="8" BorderBrush="#D0D7DE" BorderThickness="1">
        <Grid>
          <Grid IsVisible="{Binding IsOverviewVisible}"><views:OverviewView /></Grid>
          <Grid IsVisible="{Binding IsTestOperationVisible}"><views:TestOperationView DataContext="{Binding TestOperation}" /></Grid>
          <Grid IsVisible="{Binding IsProcessOverviewVisible}"><views:ProcessOverviewView DataContext="{Binding ProcessOverview}" /></Grid>
          <Grid IsVisible="{Binding IsManagementVisible}"><views:ManagementView DataContext="{Binding Management}" /></Grid>
          <Grid IsVisible="{Binding IsReportsVisible}"><views:ReportsView DataContext="{Binding Reports}" /></Grid>
          <Grid IsVisible="{Binding IsCalibrationVisible}"><views:CalibrationView DataContext="{Binding Calibration}" /></Grid>
          <Grid IsVisible="{Binding IsDiagnosticsVisible}"><views:DiagnosticsView DataContext="{Binding Diagnostics}" /></Grid>
          <Grid IsVisible="{Binding IsInstrumentVisible}"><views:InstrumentView DataContext="{Binding Instrument}" /></Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
      <TextBlock Text="{Binding ConfigText}" Classes="caption" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="{Binding LastLogText}" Classes="caption" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Window>
