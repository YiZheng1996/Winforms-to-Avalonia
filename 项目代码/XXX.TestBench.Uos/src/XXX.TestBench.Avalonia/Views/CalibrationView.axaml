<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XXX.TestBench.Avalonia.ViewModels"
             x:Class="XXX.TestBench.Avalonia.Views.CalibrationView"
             x:DataType="vm:CalibrationViewModel"
             AutomationProperties.Name="硬件校准">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel MinWidth="760" Spacing="12">
      <TextBlock Text="硬件校准" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SafetyBoundaryText}" Classes="warning" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="250,14,*">
        <ListBox x:Name="CalibrationChannelList" ItemsSource="{Binding Channels}"
                 SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" AutomationProperties.Name="校准通道列表">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CalibrationChannelViewModel">
              <StackPanel Margin="6" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding QualityText}" Classes="caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Text="本地计算草稿" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="工程值" Classes="caption" />
          <NumericUpDown x:Name="CalibrationEngineeringInput" Value="{Binding SelectedChannel.EngineeringValue, Mode=TwoWay}"
                         Increment="0.1" AutomationProperties.Name="校准工程值" />
          <TextBlock Text="Zero" Classes="caption" />
          <NumericUpDown Value="{Binding SelectedChannel.Zero, Mode=TwoWay}" Increment="0.01"
                         AutomationProperties.Name="校准零点草稿" />
          <TextBlock Text="Gain" Classes="caption" />
          <NumericUpDown Value="{Binding SelectedChannel.Gain, Mode=TwoWay}" Increment="0.01"
                         AutomationProperties.Name="校准增益草稿" />
          <Border Padding="10" Background="#F4F7FA" CornerRadius="5">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="计算结果" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedChannel.CalculatedValue}" />
              <TextBlock Text="{Binding SelectedChannel.Unit}" />
            </StackPanel>
          </Border>
          <Button x:Name="CalibrationRecalculateButton" Content="重新计算" Command="{Binding RecalculateCommand}"
                  AutomationProperties.Name="重新计算校准值" />
          <Button x:Name="CalibrationApplyButton" Content="应用 Zero/Gain（安全锁定）"
                  Command="{Binding ApplyCalibrationCommand}" IsEnabled="{Binding CanApplyCalibration}"
                  AutomationProperties.Name="应用校准值" />
          <TextBlock Text="{Binding FeedbackText}" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Legacy 输出检测（安全锁定）" FontSize="17" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Outputs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CalibrationOutputViewModel">
            <Border Width="210" Margin="0,0,8,8" Padding="9" Background="#FFF3F0" CornerRadius="5">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ChannelKind}" Classes="caption" />
                <TextBlock Text="{Binding StatusText}" Foreground="#A33A2B" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
